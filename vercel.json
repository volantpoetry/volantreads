{
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/ssr-book.js": {
      "includeFiles": "details.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/details.html",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/api/ssr-book"
    }
  ],
  "crons": [
    {
      "path": "/api/auto-release-books",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/verify-settlements",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cleanup-notifications",
      "schedule": "0 2 * * *"
    }
  ]
}