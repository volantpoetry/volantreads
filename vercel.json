{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "details.html"
    }
  },
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/details.html",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/api/ssr-book"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|.*\\.(?:png|jpg|jpeg|gif|svg|webp|ico|css|js|json|xml|txt|woff|woff2|ttf|eot|html|htm)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/auto-release-books",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/verify-settlements",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cleanup-notifications",
      "schedule": "0 2 * * *"
    }
  ]
}
